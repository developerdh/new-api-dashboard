# 数据库：New API 的 PostgreSQL 只读账号（优先从库，方案 §2.1）
# 红线：只读——不写入、不执行 DDL、不改 schema（方案 §0/§9.1）
DATABASE_URL=postgres://dashboard_readonly:password@db-host:5432/new_api

# 连接池上限（方案 §2.1：可配 10–20，超范围直接报错，不给放宽入口）
DB_POOL_MAX=10

# 建连超时（毫秒，100–60000）；探活端点必须有界返回
DB_CONNECT_TIMEOUT_MS=5000

# 时区与站点基础地址（方案 §11.1）
TZ=Asia/Shanghai
DASHBOARD_BASE_URL=http://localhost:3000

# 管理端点令牌（BE-M0-04）：/api/admin/cache/clear、/api/admin/cache/stats 与 /api/snapshot 的 Bearer 令牌；
# 留空 = 这些端点整体禁用（返回 404）。生产环境自行生成强随机值，不提交。
ADMIN_TOKEN=

# 全站访问控制（BE-M4-02）：HTTP Basic Auth（页面/查询/导出/快照读取）。
# 生产环境（NODE_ENV=production）缺少任一值将拒绝启动（fail-fast）；开发环境缺失时受保护路径返回 503。
# 不要提交真实凭据。
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASS=