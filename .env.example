# 数据库：New API 的 PostgreSQL 只读账号（优先从库，方案 §2.1）
# 红线：只读——不写入、不执行 DDL、不改 schema（方案 §0/§9.1）
DATABASE_URL=postgres://dashboard_readonly:password@db-host:5432/new_api

# 连接池上限（方案 §2.1：可配 10–20，超范围直接报错，不给放宽入口）
DB_POOL_MAX=10

# 建连超时（毫秒，100–60000）；探活端点必须有界返回
DB_CONNECT_TIMEOUT_MS=5000

# 时区与站点基础地址（方案 §11.1）
TZ=Asia/Shanghai
DASHBOARD_BASE_URL=http://localhost:3088

# 管理端点令牌：/api/admin/cache/clear、/api/admin/cache/stats 与 /api/snapshot 的 Bearer 令牌；
# 留空 = 这些端点整体禁用（返回 404）。生产环境自行生成强随机值，不提交。
ADMIN_TOKEN=

# 全站登录凭据：/login 表单账号密码，会话用 HttpOnly Cookie（页面/查询/导出/快照读取均受保护）。
# 生产环境（NODE_ENV=production）缺少任一值将拒绝启动（fail-fast）；开发环境缺失时受保护路径返回 503。
# 不要提交真实凭据。
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASS=

# 可选：会话签名密钥。留空时由上述凭据派生（改密码即令全部会话失效）。
# 多实例部署请显式配置同一强随机值，例如 openssl rand -hex 32。
DASHBOARD_SESSION_SECRET=

# ── 监控记录（提示词与返回结果）────────────────────────────────────────────
# new-api-dashcam 的 DASHCAM_DIR，看板只读访问。留空 = 该功能关闭：
# /api/dashcam/* 返回 available:false，用户详情页显示提示条而不报错。
# 本地开发指向样本副本（data/dashcam 已在 .gitignore）；容器部署见 docker-compose.yml（:ro 挂载）。
DASHCAM_DIR=

# 指纹重构前缀：调用方实际发送的 Authorization 头固定前缀。
# 代理对「完整 Authorization 字符串」做 sha256，而 tokens.key 不含 sk-，故必须拼回该前缀；
# 与实际形态不一致时表现为"查不到会话"（不会错配到别人）。
DASHCAM_TOKEN_HEADER_PREFIX=Bearer sk-

# 列表查询保护（与采集侧建议保留 90 天无关）
DASHCAM_MAX_WINDOW_DAYS=31
# 单文件读取上限（解压后字节，1024–134217728）；超出截断并在界面标注
DASHCAM_MAX_BLOB_BYTES=16777216
# 「原始报文」页签的预览上限（字节）
DASHCAM_RAW_PREVIEW_BYTES=262144
# 索引解析结果缓存 TTL（毫秒）与条目数上限（超过则不缓存，防大日文件撑爆 LRU）
DASHCAM_CACHE_TTL_MS=30000
DASHCAM_INDEX_CACHE_MAX_ENTRIES=20000
# 旧数据（索引无 token 字段）读时水合的单次请求正文数上限（1–300）；新采集数据索引自带 token，不触发
DASHCAM_USAGE_HYDRATE_MAX=100
