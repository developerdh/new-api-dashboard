# new-api-dashcam 环境变量样例
#
# systemd: 复制到 /etc/dashcam.env
# docker:  通过 env_file 或 environment 注入

# 监听地址。nginx 与代理同机时绑回环即可；容器内需 0.0.0.0。
LISTEN=127.0.0.1:3090

# new-api 地址。裸机用回环，容器用服务名。
UPSTREAM=http://127.0.0.1:3000

# 采集产物根目录，必须可写。看板侧只读挂载同一目录。
DASHCAM_DIR=/var/lib/new-api-dashboard/dashcam

# 只采集对话类路径，其余请求原样放行、不落盘。
# 图片/音频/文件类接口务必排除，否则 base64 会瞬间写满磁盘。
CAPTURE_PATHS=/v1/chat/completions,/v1/completions,/v1/messages,/v1/responses

# 磁盘防御上限（逐条正文的上限，超出截断并置 tr 位，转发不截断）。
# 128 MiB 可覆盖 1M tokens 上下文并留出多模态余量。
MAX_REQUEST_BYTES=134217728
MAX_RESPONSE_BYTES=134217728

# 超过该字节数的产物做 gzip；设为 0 关闭压缩。
GZIP_THRESHOLD=65536

# 资源围栏（落盘在后台 worker 执行，磁盘抖动不影响转发）。
# 内存预算：reqBuf+resBuf+peek 的实时总量上限；超限三层降级（拒收新请求 →
# 在途停缓冲 → 队满丢弃），只丢采集不丢转发。设为 0 = 停采总开关（热停采集）。
DASHCAM_MEM_BUDGET=268435456
# 落盘 worker 数（压缩/索引/正则都在 worker 上）。
DASHCAM_FLUSH_WORKERS=2
# 待落盘队列容量（条）；队满丢弃并计入 /healthz 的 dropped。
DASHCAM_QUEUE_CAP=256

# 上游响应头等待上限。不含 body 读取，流式响应不受此限制。
UPSTREAM_HEADER_TIMEOUT=300s

# 上游每主机连接上限（转发侧背板）：超限排队等待而非新建连接。
UPSTREAM_MAX_CONNS_PER_HOST=2048
# keep-alive 空闲连接回收；不影响流式响应（WriteTimeout 始终不设）。
IDLE_TIMEOUT=120s

# 按调用方指纹整体抽样（默认关闭 = 全量记录）。
# 判定：sha256(指纹) % SAMPLE_MODULUS < SAMPLE_KEEP 才采集；被抽中的指纹全量记录，
# 未抽中的完全不落盘。启用时须 1 ≤ SAMPLE_KEEP ≤ SAMPLE_MODULUS，否则启动失败。
# 注意：抽样开启期间请求量汇总只反映被抽中部分，总量口径以 New API 主库为准。
SAMPLE_MODULUS=0
SAMPLE_KEEP=1

# ===== 以下变量供 clean-dashcam.sh（清理脚本）读取，代理进程不使用 =====

# 采集数据保留天数；0 = 禁用清理。systemd timer / cron 示例见 docs/dashcam/03-deployment.md §7。
DASHCAM_RETENTION_DAYS=90
