[Unit]
Description=New API audit capture proxy
Documentation=file:/opt/audit-proxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=audit
Group=audit
EnvironmentFile=/etc/audit-proxy.env
ExecStart=/opt/audit-proxy/audit-proxy
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2s
LimitNOFILE=65535

# 加固：代理只需要写审计目录，其余路径只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/new-api-dashboard/audit

StandardOutput=journal
StandardError=journal
SyslogIdentifier=audit-proxy

[Install]
WantedBy=multi-user.target
