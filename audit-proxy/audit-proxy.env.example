# audit-proxy 环境变量样例
#
# systemd: 复制到 /etc/audit-proxy.env
# docker:  通过 env_file 或 environment 注入

# 监听地址。nginx 与代理同机时绑回环即可；容器内需 0.0.0.0。
LISTEN=127.0.0.1:8090

# new-api 地址。裸机用回环，容器用服务名。
UPSTREAM=http://127.0.0.1:3000

# 采集产物根目录，必须可写。看板侧只读挂载同一目录。
AUDIT_DIR=/var/lib/new-api-dashboard/audit

# 只采集对话类路径，其余请求原样放行、不落盘。
# 图片/音频/文件类接口务必排除，否则 base64 会瞬间写满磁盘。
CAPTURE_PATHS=/v1/chat/completions,/v1/completions,/v1/messages,/v1/responses

# 磁盘防御上限（不是内存上限：代理边转发边写盘，内存恒定）。
# 128 MiB 可覆盖 1M tokens 上下文并留出多模态余量。
MAX_REQUEST_BYTES=134217728
MAX_RESPONSE_BYTES=134217728

# 超过该字节数的产物做 gzip；设为 0 关闭压缩。
GZIP_THRESHOLD=65536

# 上游响应头等待上限。不含 body 读取，流式响应不受此限制。
UPSTREAM_HEADER_TIMEOUT=300s
